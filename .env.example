# Copy to .env and fill in real values. Never commit .env.
POSTGRES_USER=dealership
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dealership
POSTGRES_PORT=5432

# App database. Local dev default is a SQLite file; use Postgres in docker/prod.
DATABASE_URL=sqlite:///./dealership.db
# DATABASE_URL=postgresql+psycopg://dealership:change-me@localhost:5432/dealership
# Optional: run the test-suite against Postgres instead of a temp SQLite file
# TEST_DATABASE_URL=postgresql+psycopg://dealership:change-me@localhost:5432/dealership_test

JWT_SECRET_KEY=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Used only by the seed script (python -m app.seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
